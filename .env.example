# API
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/growtix
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret
CORS_ORIGIN=http://localhost:5173

# Links in verification / password-reset emails (no trailing slash)
PUBLIC_WEB_URL=http://localhost:5173
EMAIL_FROM=Growtix <noreply@localhost>
# console | resend — workers log email body when console; set RESEND_API_KEY for resend
EMAIL_PROVIDER=console
RESEND_API_KEY=

# AI & integrations (optional for local dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (SendGrid-style webhook verification optional)
SENDGRID_WEBHOOK_SECRET=
